}
function rowHtml_(d,total){return `<div class="di"><i style="background:${d.color}"></i><span>${esc(d.label)}</span><b>${fmt(d.val)}</b><span class="pct">${total>0?(d.val/total*100).toFixed(1):'0.0'}%</span></div>`;}
