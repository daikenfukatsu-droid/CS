function bucketHasData(b){return AGG.days.some(d=>d.d>=b.start&&d.d<=b.end);}
function aggDays(days){const A={t:0,k:0,e:0,o:{}};days.forEach(z=>{A.t+=z.t;A.k+=z.k;A.e+=(z.e||0);for(const n in z.o){A.o[n]=A.o[n]||[0,0,0];A.o[n][0]+=z.o[n][0];A.o[n][1]+=z.o[n][1];A.o[n][2]+=(z.o[n][2]||0);}});return A;}
