  document.getElementById('segUnit').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;state.unit=b.dataset.u;state.bkey=null;render();});
  document.getElementById('fyToggle').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;state.fy=b.dataset.f;state.bkey=null;refreshOwnerSelect();render();});
  document.getElementById('chips').addEventListener('click',e=>{const b=e.target.closest('button');if(!b||b.disabled)return;state.bkey=b.dataset.k;render();});
  document.getElementById('trendOwner').addEventListener('change',e=>{state.owner=e.target.value;render();});
  document.getElementById('crossRowSel').addEventListener('change',e=>{const i=+e.target.value;state.crossRow=i;if(state.crossCol===i)state.crossCol=DIM.findIndex((_,j)=>j!==i);render();});
  document.getElementById('crossColSel').addEventListener('change',e=>{state.crossCol=+e.target.value;render();});
  document.getElementById('crossMetric').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;state.crossMetric=b.dataset.m;render();});
  document.getElementById('kpi').addEventListener('click',e=>{const b=e.target.closest('.kdetail');if(b)openDrawer(b.dataset.mode);});
  document.getElementById('drawerClose').addEventListener('click',closeDrawer);
  document.getElementById('drawerOv').addEventListener('click',closeDrawer);
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeDrawer();});
  document.getElementById('drawerBody').addEventListener('click',e=>{
    const own=e.target.closest('.ownrow'); if(own){state.cO=+own.dataset.o;state.cLevel=2;refreshDrawer();return;}
    const st=e.target.closest('.strow'); if(st){state.cS=+st.dataset.s;state.cLevel=3;refreshDrawer();return;}
    const co=e.target.closest('.corow'); if(co){state.cTid=co.dataset.tid;state.cLevel=4;refreshDrawer();return;}
    if(e.target.closest('.drwback')){state.cLevel=Math.max(1,state.cLevel-1);refreshDrawer();return;}
  });
})();
</script>
</body>
</html>
