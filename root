<!DOCTYPE html>
<html lang="ja">
<head>
<base target="_top">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>自己完結率 分析ダッシュボード</title>
<style>
  :root{
    --bg:#eef1f6; --panel:#ffffff; --panel-2:#f7f9fc;
    --ink:#12203a; --ink-2:#5a6b85; --ink-3:#8a99b3;
    --line:#e3e8f0; --line-2:#eef2f7;
    --brand:#0f1b32; --brand-ink:#c7d2e6; --brand-ink-2:#7c8bab;
    --accent:#2a6fd6; --accent-soft:#e7f0fc;
    --good:#0ca35a; --okblue:#2a6fd6; --warn:#e79a00; --crit:#e0483f;
    --c1:#2a6fd6; --c2:#17a67a; --c3:#e79a00; --c4:#7a5cd0; --c5:#e06aa0; --c6:#4aa3b8; --c7:#8a99b3; --c8:#c98f4a;
    --r1:#e0483f; --r2:#ef7a52; --r3:#f0a63a; --r4:#c76b8e; --r5:#9aa7bd; --r6:#c98f4a;
    --shadow:0 1px 2px rgba(16,32,58,.06),0 6px 20px rgba(16,32,58,.05);
    --radius:14px;
    --font:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic UI","Meiryo",system-ui,sans-serif;
  }
  @media (prefers-color-scheme:dark){
    :root{
      --bg:#0c1017; --panel:#141a24; --panel-2:#10151d;
      --ink:#eef2f8; --ink-2:#a7b4c7; --ink-3:#6f7d93;
      --line:#232c3a; --line-2:#1b2330;
      --brand:#0a0e15; --brand-ink:#c7d2e6; --brand-ink-2:#6f7d93;
      --accent:#4f92ec; --accent-soft:#17263c;
      --good:#25b06a; --okblue:#4f92ec; --warn:#f0ab2e; --crit:#ef6a61;
      --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);
    }
  }
  *{box-sizing:border-box} html,body{margin:0;padding:0}
  .srd{font-family:var(--font);background:var(--bg);color:var(--ink);min-height:100vh;display:grid;grid-template-columns:212px 1fr;font-feature-settings:"palt";}
  .side{background:var(--brand);color:var(--brand-ink);padding:20px 16px;display:flex;flex-direction:column;gap:24px;position:sticky;top:0;height:100vh}
  .brand{display:flex;align-items:center;gap:11px}
  .brand .logo{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#2a6fd6,#4aa3b8);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:16px}
  .brand b{font-size:14px;color:#fff;font-weight:600}
  .brand span{display:block;font-size:11px;color:var(--brand-ink-2);margin-top:2px}
  .nav a{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:9px;color:#fff;text-decoration:none;font-size:13.5px;background:var(--accent)}
  .side .foot{margin-top:auto;font-size:11px;color:var(--brand-ink-2);display:flex;flex-direction:column;gap:9px}
  .link-badge{display:flex;align-items:center;gap:8px;color:var(--brand-ink)}
  .live{width:7px;height:7px;border-radius:50%;background:var(--good);box-shadow:0 0 0 3px color-mix(in srgb,var(--good) 25%,transparent)}
  .main{padding:22px 26px 40px;min-width:0}
  .top{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px;justify-content:space-between;margin-bottom:14px}
  .top h1{font-size:21px;font-weight:700;margin:0}
  .top .sub{font-size:12.5px;color:var(--ink-2);margin-top:3px}
  .snap{font-size:11px;color:var(--ink-3);border:1px dashed var(--line);padding:5px 10px;border-radius:8px;align-self:center}
  .selbase,.cc-sel,.miniowner{appearance:none;background:var(--panel);border:1px solid var(--line);color:var(--ink);font-family:inherit;cursor:pointer;
    background-image:linear-gradient(45deg,transparent 50%,var(--ink-3) 50%),linear-gradient(135deg,var(--ink-3) 50%,transparent 50%);
    background-position:calc(100% - 16px) 55%,calc(100% - 11px) 55%;background-size:5px 5px,5px 5px;background-repeat:no-repeat}
  .ctrl{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px 16px;margin-bottom:16px;display:flex;flex-direction:column;gap:12px}
  .ctrl-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:space-between}
  .ctrl-left{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .clabel{font-size:11px;letter-spacing:.06em;color:var(--ink-3);font-weight:600}
  .seg{display:inline-flex;gap:6px;flex-wrap:wrap}
  .seg button,.fy button{font-family:inherit;font-size:13px;font-weight:600;color:var(--ink-2);background:var(--panel);border:1px solid var(--line);padding:7px 15px;border-radius:9px;cursor:pointer;transition:.12s}
  .seg button:hover,.fy button:hover{border-color:var(--accent);color:var(--ink)}
  .seg button.on,.fy button.on{background:var(--accent);color:#fff;border-color:var(--accent)}
  .fy{display:inline-flex;gap:6px}
  .chiprow{display:flex;gap:8px;overflow-x:auto;padding-bottom:2px}
  .chiprow button{font-family:inherit;font-size:13px;color:var(--ink-2);background:var(--panel);border:1px solid var(--line);padding:6px 13px;border-radius:8px;cursor:pointer;white-space:nowrap}
  .chiprow button:hover{border-color:var(--accent)}
  .chiprow button.on{background:var(--accent);color:#fff;border-color:var(--accent)}
  .chiprow button:disabled{opacity:.4;cursor:default}
  .kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:12px}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 15px;box-shadow:var(--shadow);position:relative;overflow:hidden}
  .kpi .k{font-size:11.5px;color:var(--ink-2)}
  .kpi .v{font-size:26px;font-weight:700;margin-top:6px;font-variant-numeric:tabular-nums;line-height:1}
  .kpi .d{font-size:11.5px;margin-top:7px;font-weight:600}
  .kpi .d.up{color:var(--good)} .kpi .d.dn{color:var(--crit)} .kpi .d.mut{color:var(--ink-3);font-weight:500}
  .kpi .stripe{position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--accent)}
  .kpi.k-good .stripe{background:var(--good)} .kpi.k-warn .stripe{background:var(--warn)} .kpi.k-crit .stripe{background:var(--crit)}
  .kdetail{position:absolute;top:9px;right:9px;font-size:10.5px;color:var(--accent);background:var(--accent-soft);border:none;border-radius:20px;padding:3px 10px;cursor:pointer;font-family:inherit;z-index:2}
  .kdetail:hover{filter:brightness(0.97)}
  .flow{display:flex;align-items:stretch;gap:4px;width:100%}
  .fbox{flex:1 1 0;min-width:0;background:var(--panel-2);border:1px solid var(--line);border-radius:9px;padding:8px 5px;display:flex;flex-direction:column;gap:2px;text-align:center;justify-content:center}
  .fbox .fn{font-size:10px;color:var(--ink-2);line-height:1.2;word-break:break-word}
  .fbox .fv{font-size:17px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--ink);line-height:1}
  .fbox.done{background:color-mix(in srgb,var(--good) 12%,var(--panel));border-color:color-mix(in srgb,var(--good) 40%,var(--line))}
  .fbox.done .fn,.fbox.done .fv{color:var(--good)}
  .farr{flex:0 0 auto;align-self:center;color:var(--ink-3);font-size:12px}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px 17px;box-shadow:var(--shadow);margin-bottom:12px}
  .panel h3{font-size:13.5px;font-weight:600;margin:0 0 2px}
  .panel .pnote{font-size:11px;color:var(--ink-3);margin:0}
  .phead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
  .tag{font-size:10.5px;color:var(--ink-2);background:var(--panel-2);border:1px solid var(--line);padding:3px 8px;border-radius:20px;white-space:nowrap}
  .ownersel{display:flex;align-items:center;gap:7px}
  .miniowner{font-size:12px;border-radius:8px;padding:5px 28px 5px 9px}
  .legend{display:flex;flex-wrap:wrap;gap:10px 16px;margin-top:10px;font-size:12px;color:var(--ink-2)}
  .legend span{display:inline-flex;align-items:center;gap:6px}.legend i{width:10px;height:10px;border-radius:3px}
  .cctrl{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin-bottom:12px}
  .cc-axis{display:flex;align-items:center;gap:8px}
  .cc-lab{font-size:11px;color:var(--ink-3);font-weight:600}
  .cc-sel{font-size:13px;padding:7px 30px 7px 12px;border-radius:9px;min-width:150px}
  .cc-sel:focus{outline:2px solid var(--accent);outline-offset:1px}
  .cc-metric{margin-left:auto;display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
  .cc-metric button{font-family:inherit;font-size:12px;font-weight:600;color:var(--ink-2);background:var(--panel);border:none;padding:6px 14px;cursor:pointer}
  .cc-metric button.on{background:var(--accent);color:#fff}
  .ctbl{border-collapse:separate;border-spacing:3px;font-size:12px;min-width:560px;font-variant-numeric:tabular-nums}
  .ctbl th{color:var(--ink-3);font-weight:500;font-size:11px;padding:6px 8px;text-align:center;white-space:nowrap}
  .ctbl th.rowh{text-align:left}
  .ctbl td{text-align:center;padding:7px 8px;border-radius:6px;white-space:nowrap}
  .ctbl td.rowlab{text-align:left;font-weight:500;color:var(--ink);white-space:nowrap}
  .ctbl td.tot{background:var(--panel-2);font-weight:600;color:var(--ink)}
  .ctbl td.grand{background:var(--accent-soft);color:var(--accent);font-weight:700}
  svg{display:block;width:100%;height:100%}
  .chart-vol{height:230px} .chart-donut{height:230px}
  .donut-wrap{display:grid;grid-template-columns:180px 1fr;gap:12px;align-items:center}
  .dlist{display:flex;flex-direction:column;gap:6px;font-size:12px}
  .dlist .di{display:grid;grid-template-columns:11px 1fr auto auto;gap:9px;align-items:center;color:var(--ink-2)}
  .dlist .di i{width:11px;height:11px;border-radius:3px}
  .dlist .di b{color:var(--ink);font-variant-numeric:tabular-nums;font-weight:600}
  .dlist .di .pct{color:var(--ink-3);font-variant-numeric:tabular-nums;min-width:42px;text-align:right}
  .di-more{display:flex;flex-direction:column;gap:6px}
  .di-toggle{margin-top:5px;font-family:inherit;font-size:11.5px;color:var(--accent);background:none;border:none;cursor:pointer;text-align:left;padding:2px 0}
  .di-toggle:hover{text-decoration:underline}
  .empty{color:var(--ink-3);font-size:12.5px;padding:20px 0;text-align:center}
  .drawer-ov{position:fixed;inset:0;background:rgba(0,0,0,.35);opacity:0;visibility:hidden;transition:opacity .2s,visibility .2s;z-index:40}
  .drawer-ov.open{opacity:1;visibility:visible}
  .drawer{position:fixed;top:0;right:0;height:100vh;width:430px;max-width:92vw;background:var(--panel);box-shadow:-8px 0 30px rgba(0,0,0,.18);transform:translateX(100%);transition:transform .25s ease;z-index:50;padding:20px;overflow-y:auto}
  .drawer.open{transform:translateX(0)}
  .drawer-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
  .drawer-h h3{font-size:15px;font-weight:600;margin:0}
  .drawer-h button{background:none;border:none;font-size:18px;color:var(--ink-3);cursor:pointer;line-height:1}
  @keyframes drwin{from{opacity:.3;transform:translateX(26px)}to{opacity:1;transform:none}}
  .drw-anim{animation:drwin .22s ease}
  .dbar{height:14px;background:var(--line-2);border-radius:5px;overflow:hidden}
  .dbar-f{height:100%;border-radius:5px}
  .dsub{font-size:10.5px;color:var(--ink-3);margin-top:4px}
  .l1row{display:grid;grid-template-columns:1fr auto 14px;gap:8px;align-items:center;padding:9px 11px;border:1px solid var(--line);border-radius:8px;cursor:pointer;font-size:12.5px}
  .l1row:hover{border-color:var(--accent)}
  .l1row .l1nm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .l1row .l1nm .st{color:var(--ink-3)}
  .l1row b{font-variant-numeric:tabular-nums}
  .l1row .chev{color:var(--ink-3)}
  .drwback{font-size:12px;color:var(--accent);background:none;border:none;cursor:pointer;padding:0;font-family:inherit;margin-bottom:10px}
  .drwback:hover{text-decoration:underline}
  .tdlbl{font-size:10.5px;color:var(--ink-3)}
  .tdval{font-size:13px;color:var(--ink);line-height:1.5;word-break:break-word}
  .tdsubj{font-size:15px;font-weight:600;line-height:1.4;margin:2px 0 8px}
  .tdbtns{display:flex;gap:8px;margin-top:8px}
  .tdbtn{flex:1;text-align:center;padding:9px;border-radius:8px;font-size:12.5px;font-weight:500;text-decoration:none;cursor:pointer}
  .tdbtn.pri{background:var(--accent-soft);color:var(--accent)}
  .tdbtn.sec{border:1px solid var(--line);color:var(--ink)}
  @media (max-width:1080px){ .srd{grid-template-columns:1fr} .side{position:static;height:auto;flex-direction:row;flex-wrap:wrap;align-items:center} .side .foot{margin-left:auto;flex-direction:row} .kpis{grid-template-columns:repeat(3,1fr)} .row2{grid-template-columns:1fr} }
  @media (max-width:560px){ .kpis{grid-template-columns:repeat(2,1fr)} .donut-wrap{grid-template-columns:1fr} .cc-metric{margin-left:0} .fbox .fv{font-size:13px} .fbox .fn{font-size:8.5px} }
</style>
</head>
<body>
<div class="srd">
  <aside class="side">
    <div class="brand"><div class="logo">CS</div><div><b>採用一括かんりくん</b><span>CSサポート KPI</span></div></div>
    <nav class="nav"><a href="#">サマリー</a></nav>
    <div class="foot">
      <div style="letter-spacing:.08em;font-size:10px;text-transform:uppercase">データ連携</div>
      <div class="link-badge"><span class="live"></span>HubSpot ・ raw_all</div>
      <div>対応件数＝全件／率は評価済みベース</div>
    </div>
  </aside>
  <main class="main">
    <div class="top">
      <div><h1>自己完結率 分析ダッシュボード</h1><div class="sub">HubSpot サポートチケット × 自己完結率KPI（○＝自己完結）</div></div>
      <div class="snap" id="snap"></div>
    </div>

    <div class="ctrl">
      <div class="ctrl-row">
        <div class="ctrl-left"><span class="clabel">表示単位</span><div class="seg" id="segUnit"></div></div>
        <div class="fy" id="fyToggle"></div>
      </div>
      <div class="chiprow" id="chips"></div>
    </div>

    <section class="kpis" id="kpi"></section>

    <div class="panel">
      <div class="phead"><div><h3>ステータス別フロー</h3><p class="pnote">選択期間の作成チケットを現在ステータス別に集計（緑＝完了系）</p></div><span class="tag" id="flowTag"></span></div>
      <div class="flow" id="flow"></div>
    </div>

    <div class="panel">
      <div class="phead"><div><h3>件数の推移</h3><p class="pnote" id="volNote"></p></div>
        <div class="ownersel"><span class="clabel" style="font-size:11px">担当者</span>
          <select class="selbase miniowner" id="trendOwner"><option value="all">全担当者</option></select></div></div>
      <div class="chart-vol" id="chVol"></div>
      <div class="legend"><span><i style="background:var(--okblue)"></i>自己完結</span><span><i style="background:var(--line)"></i>それ以外</span></div>
    </div>

    <div class="row2">
      <div class="panel"><div class="phead"><div><h3>ケース種別の内訳</h3><p class="pnote">件数シェア（選択期間）</p></div></div>
        <div class="donut-wrap"><div class="chart-donut" id="chCase"></div><div class="dlist" id="lgCase"></div></div></div>
      <div class="panel"><div class="phead"><div><h3>未達（×・△）の理由内訳</h3><p class="pnote">kpiValue（J列）ベース</p></div></div>
        <div class="donut-wrap"><div class="chart-donut" id="chReason"></div><div class="dlist" id="lgReason"></div></div></div>
    </div>

    <div class="row2">
      <div class="panel"><div class="phead"><div><h3>発生源（origin）の内訳</h3><p class="pnote">件数シェア（選択期間）</p></div></div>
        <div class="donut-wrap"><div class="chart-donut" id="chOrigin"></div><div class="dlist" id="lgOrigin"></div></div></div>
      <div class="panel"><div class="phead"><div><h3>領域 の内訳</h3><p class="pnote">件数シェア（選択期間）</p></div></div>
        <div class="donut-wrap"><div class="chart-donut" id="chCs"></div><div class="dlist" id="lgCs"></div></div></div>
    </div>

    <div class="row2">
      <div class="panel"><div class="phead"><div><h3>原因_大分類 の内訳</h3><p class="pnote">上位10件（残りはトグル）・原因入力ありのみ</p></div></div>
        <div class="donut-wrap"><div class="chart-donut" id="chCmaj"></div><div class="dlist" id="lgCmaj"></div></div></div>
      <div class="panel"><div class="phead"><div><h3>原因_小分類 の内訳</h3><p class="pnote">上位10件（残りはトグル）・原因入力ありのみ</p></div></div>
        <div class="donut-wrap"><div class="chart-donut" id="chCmin"></div><div class="dlist" id="lgCmin"></div></div></div>
    </div>

    <div class="panel">
      <div class="phead"><div><h3>クロス分析</h3><p class="pnote">縦軸×横軸を選択（同一項目は不可）／件数・％（全体比）切替</p></div><span class="tag" id="crossTag"></span></div>
      <div class="cctrl">
        <div class="cc-axis"><span class="cc-lab">縦軸</span><select class="cc-sel" id="crossRowSel"></select></div>
        <div class="cc-axis"><span class="cc-lab">横軸</span><select class="cc-sel" id="crossColSel"></select></div>
        <div class="cc-metric" id="crossMetric"><button data-m="count" class="on">件数</button><button data-m="pct">％</button></div>
      </div>
      <div style="overflow-x:auto"><table class="ctbl" id="crossTbl"></table></div>
    </div>
  </main>
</div>

<div class="drawer-ov" id="drawerOv"></div>
<aside class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer-h"><h3 id="drawerTitle">詳細</h3><button id="drawerClose" type="button" aria-label="閉じる">✕</button></div>
  <p class="pnote" id="drawerNote"></p>
  <div id="drawerBody" style="display:flex;flex-direction:column;gap:8px;margin-top:10px"></div>
</aside>

<script>
const AGG = <?!= aggJson ?>;
const TARGET = 85;
const TOPN = 10;
const URLBASE = 'https://app.hubspot.com/help-desk/23871469/view/105598228/ticket/';
const UNITS = ['毎日','週次','月間','四半期','半期','年間'];
const DIM = [{k:'case',label:'ケース種別'},{k:'reason',label:'未達理由'},{k:'origin',label:'発生源'},{k:'area',label:'領域'},{k:'cmaj',label:'原因_大分類'},{k:'cmin',label:'原因_小分類'}];
const FLOW = ['未対応','メール返信有','返信待ち','対応中','回答チェック中','リマインド対応要','顧客対応待ち','開発対応待ち','開発調査中','未解消完了','対応完了'];
const DONE = {'未解消完了':1,'対応完了':1};
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const fmt = n => n.toLocaleString('ja-JP');
const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const pct = (o,t) => t>0 ? o/t*100 : 0;
const pad = n => ('0'+n).slice(-2);
const state = { fy:(AGG.fys||[]).slice(-1)[0]||'FY'+new Date().getFullYear(), unit:'月間', bkey:null, owner:'all', crossRow:2, crossCol:0, crossMetric:'count', drawer:null, cLevel:1, cO:-1, cS:-1, cTid:'' };
let _RR=[], _A={o:{}}, _tag='', _lastDrwKey='';

function addDays(ymd,n){const[Y,M,D]=ymd.split('-').map(Number);const dt=new Date(Date.UTC(Y,M-1,D));dt.setUTCDate(dt.getUTCDate()+n);return dt.toISOString().slice(0,10);}
function monthEnd(y,m){return new Date(Date.UTC(y,m,0)).toISOString().slice(0,10);}
function weekStart(ymd){const[Y,M,D]=ymd.split('-').map(Number);const dt=new Date(Date.UTC(Y,M-1,D));const wd=(dt.getUTCDay()+6)%7;dt.setUTCDate(dt.getUTCDate()-wd);return dt.toISOString().slice(0,10);}
function fyYear(fy){return +fy.slice(2);}
function fyRange(fy){const y=fyYear(fy);return [`${y}-04-01`,`${y+1}-03-31`];}
function daysInRange(s,e){return AGG.days.filter(d=>d.d>=s&&d.d<=e);}

function buckets(fy,unit){
  const y=fyYear(fy),[fs,fe]=fyRange(fy),out=[];
  if(unit==='年間'){out.push({key:'y',label:'通年',start:fs,end:fe});}
