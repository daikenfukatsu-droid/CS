function crossTable(RR){
  const ri=state.crossRow,ci=state.crossCol,rk=DIM[ri].k,ck=DIM[ci].k;
  const cellM={},rTot={},cTot={};let grand=0,maxCell=1;
  RR.forEach(t=>{const rv=t[ri],cv=t[ci];if(rv<0||cv<0)return;const key=rv+'_'+cv;cellM[key]=(cellM[key]||0)+1;rTot[rv]=(rTot[rv]||0)+1;cTot[cv]=(cTot[cv]||0)+1;grand++;});
  for(const k in cellM)if(cellM[k]>maxCell)maxCell=cellM[k];
  const rowVals=Object.keys(rTot).sort((a,b)=>rTot[b]-rTot[a]);
  const colVals=Object.keys(cTot).sort((a,b)=>cTot[b]-cTot[a]);
  const el=document.getElementById('crossTbl');
  if(!rowVals.length){el.innerHTML='<tbody><tr><td class="rowlab">データがありません</td></tr></tbody>';return;}
  const disp=v=>state.crossMetric==='count'?(v||''):(v?(v/grand*100).toFixed(1)+'%':'');
  let h=`<thead><tr><th class="rowh">${DIM[ri].label}＼${DIM[ci].label}</th>`;
  colVals.forEach(cv=>h+=`<th>${esc(AGG.dict[ck][cv])}</th>`);h+='<th style="text-align:center">行計</th></tr></thead><tbody>';
  rowVals.forEach(rv=>{h+=`<tr><td class="rowlab">${esc(AGG.dict[rk][rv])}</td>`;
    colVals.forEach(cv=>{const v=cellM[rv+'_'+cv]||0,t=v/maxCell,p=Math.round(t*100);
      h+=`<td style="background:${v?`color-mix(in srgb, var(--accent) ${p}%, var(--panel))`:'transparent'};color:${t>0.5?'#fff':'var(--ink)'};font-weight:${t>=0.5?600:400}">${disp(v)}</td>`;});
    h+=`<td class="tot">${disp(rTot[rv])}</td></tr>`;});
  h+='<tr><td class="rowlab" style="font-weight:600">列計</td>';
  colVals.forEach(cv=>h+=`<td class="tot">${disp(cTot[cv])}</td>`);
  h+=`<td class="grand">${state.crossMetric==='count'?fmt(grand):'100%'}</td></tr></tbody>`;
  el.innerHTML=h;
}
