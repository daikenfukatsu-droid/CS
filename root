  else if(unit==='月間'){for(let i=0;i<12;i++){const mm=((3+i)%12)+1,cy=i<=8?y:y+1;out.push({key:`m${cy}-${pad(mm)}`,label:`${mm}月`,start:`${cy}-${pad(mm)}-01`,end:monthEnd(cy,mm)});}}
