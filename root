function donut(el,items,big,small){
  if(!items.length){el.innerHTML='<div class="empty">データなし</div>';return;}
  const W=180,H=230,cx=90,cy=110,r=72,ri=46;const total=items.reduce((s,d)=>s+d.val,0)||1;let a=-Math.PI/2,segs='';
  items.forEach(d=>{const f=d.val/total,a2=a+f*Math.PI*2,x1=cx+r*Math.cos(a),y1=cy+r*Math.sin(a),x2=cx+r*Math.cos(a2),y2=cy+r*Math.sin(a2),x3=cx+ri*Math.cos(a2),y3=cy+ri*Math.sin(a2),x4=cx+ri*Math.cos(a),y4=cy+ri*Math.sin(a),laf=f>0.5?1:0;
    segs+=`<path d="M${x1} ${y1} A${r} ${r} 0 ${laf} 1 ${x2} ${y2} L${x3} ${y3} A${ri} ${ri} 0 ${laf} 0 ${x4} ${y4} Z" fill="${d.color}" stroke="${cssv('--panel')}" stroke-width="2"><title>${esc(d.label)}: ${d.val}件 (${(f*100).toFixed(1)}%)</title></path>`;a=a2;});
